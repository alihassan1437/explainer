          "rect": [
            -0.95,
            "yt",
            0.95,
            "headY"
          ],
          "color": "flame",
          "alpha": "flame"
        },
        {
          "type": "circle",
          "id": "gas",
          "repeat": 38,
          "stroke": "none",
          "let": {
            "b": "cyc*1000+i*8",
            "gu": "(rand(b)*2-1)*0.84",
            "gv": "0.06+rand(b+1)*0.88",
            "en": "40+i/38*90+rand(b+2)*4",
            "ex": "585+i/38*90+rand(b+3)*4",
            "w1": "3+rand(b+4)*5",
            "w2": "3+rand(b+5)*5",
            "p1": "rand(b+6)*6.28",
            "p2": "rand(b+7)*6.28",
            "jx": "sin(t*w1+p1)*0.045*heat",
            "jy": "sin(t*w2+p2)*0.04*heat",
            "hx": "clamp(gu+jx,-0.86,0.86)",
            "hy": "yt+clamp(gv+jy/max(hh,0.2),0.04,0.96)*hh",
            "k1": "ease((phi-en)/38)",
            "k3": "ease((phi-ex)/42)",
            "ix": "if(k1<0.45,mix(-1.85,-0.5,k1/0.45),if(k1<0.65,-0.5,mix(-0.5,hx,(k1-0.65)/0.35)))",
            "iy": "if(k1<0.45,ductY,if(k1<0.65,mix(ductY,headY-0.05,(k1-0.45)/0.2),mix(headY-0.05,hy,(k1-0.65)/0.35)))",
            "ox": "if(k3<0.3,mix(hx,0.5,k3/0.3),if(k3<0.45,0.5,mix(0.5,1.9,(k3-0.45)/0.55)))",
            "oy": "if(k3<0.3,mix(hy,headY-0.05,k3/0.3),if(k3<0.45,mix(headY-0.05,ductY,(k3-0.3)/0.15),ductY))",
            "ph": "if(phi<en,0,if(phi<en+38,1,if(phi<ex,2,if(phi<ex+42,3,4))))",
            "pb": "if(ph==2,burn,0)"
          },
          "x": "if(ph==1,ix,if(ph==3,ox,hx))",
          "y": "if(ph==1,iy,if(ph==3,oy,hy))",
          "r": 0.04,
          "alpha": "0.95*if(ph==0,0,if(ph==1,smooth(0,0.2,k1),if(ph==2,1,if(ph==3,1-smooth(0.75,1,k3),0))))",
          "fill": {
            "mix": [
              "mixture",
              {
                "mix": [
                  "exhaust",
                  "flame"
                ],
                "by": "pb*0.95"
              }
