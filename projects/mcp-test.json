{
  "aspect": "16:9",
  "theme": "blueprint",
  "scenes": [
    {
      "block": "title",
      "text": "How a car engine works",
      "subtitle": "This engine is written as data, not built into the app",
      "lengthMs": 3600
    },
    {
      "block": "drawing",
      "title": "The four-stroke cycle",
      "lengthMs": 34000,
      "stage": {
        "w": 8.4,
        "h": 6.2,
        "cx": -0.1,
        "cy": 1.7
      },
      "params": {
        "R": 0.55,
        "L": 1.9,
        "headY": 2.85,
        "ductY": 3.05,
        "camY": 4.1,
        "camR": 0.28,
        "lobe": 0.18,
        "lw": 0.366
      },
      "vars": {
        "crank": "t*720/len",
        "phi": "wrap(crank,720)",
        "cyc": "floor(crank/720)",
        "th": "rad(wrap(phi,360))",
        "pinY": "R*cos(th)+sqrt(L*L-pow(R*sin(th),2))",
        "yt": "pinY+0.2",
        "yb": "pinY-0.3",
        "cpx": "R*sin(th)",
        "cpy": "R*cos(th)",
        "stroke": "floor(phi/180)",
        "sp": "wrap(phi,180)/180",
        "camIn": "rad((phi-90)/2)",
        "camEx": "rad((phi-630)/2)",
        "liftIn": "lobe*exp(-pow(wrappi(camIn)/lw,2))",
        "liftEx": "lobe*exp(-pow(wrappi(camEx)/lw,2))",
        "spark": "smooth(350,358,phi)*(1-smooth(366,374,phi))",
        "flame": "if(phi>=360&&phi<540,exp(-(phi-360)/55)*smooth(360,366,phi),0)",
        "burn": "if(phi<360,0,clamp(1-(phi-360)/260,0,1))",
        "heat": "if(phi<360,0.5+0.9*smooth(180,360,phi),if(phi<540,2,1.1))",
        "hh": "headY-yt",
        "pg": "flame*0.9",
        "ig": "step(360,phi)",
        "sb": "(cyc*1000+floor(phi/2))*16",
        "rx": "0-cpx",
        "ry": "pinY-cpy",
        "rl": "sqrt(rx*rx+ry*ry)",
        "nx": "0-ry/rl*0.07",
        "ny": "rx/rl*0.07"
      },
      "parts": {
